<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
  <Type Name="si::length"><DisplayString>{_linearized_value} m</DisplayString></Type>
  <Type Name="si::time"><DisplayString>{_linearized_value} s</DisplayString></Type>
  <Type Name="si::mass"><DisplayString>{_linearized_value} kg</DisplayString></Type>
  <Type Name="si::temperature"><DisplayString>{_linearized_value} K</DisplayString></Type>
  <Type Name="si::current"><DisplayString>{_linearized_value} V</DisplayString></Type>
  <Type Name="si::substance"><DisplayString>{_linearized_value} mol</DisplayString></Type>
  <Type Name="si::luminous_intensity"><DisplayString>{_linearized_value} cd</DisplayString></Type>

  <Type Name="si::area"><DisplayString>{_linearized_value} m²</DisplayString></Type>
  <Type Name="si::volume"><DisplayString>{_linearized_value} m³</DisplayString></Type>
  <Type Name="si::velocity"><DisplayString>{_linearized_value} m/s</DisplayString></Type>
  <Type Name="si::acceleration"><DisplayString>{_linearized_value} m/s²</DisplayString></Type>
  <Type Name="si::frequency"><DisplayString>{_linearized_value} Hz</DisplayString></Type>

  <Type Name="si::data_size"><DisplayString>{_linearized_value} bit</DisplayString></Type>
  <Type Name="si::data_per_time"><DisplayString>{_linearized_value} bit/s</DisplayString></Type>
  <Type Name="si::data_per_area"><DisplayString>{_linearized_value} bit/m²</DisplayString></Type>
  <Type Name="si::data_per_volume"><DisplayString>{_linearized_value} bit/m³</DisplayString></Type>
</AutoVisualizer>
